    "inlineSchema": "// 文件说明：数据库模型定义，描述数据表、枚举及关联关系。\ngenerator client {\n  provider     = \"prisma-client\"\n  output       = \"../generated/prisma\"\n  moduleFormat = \"cjs\"\n}\n\ndatasource db {\n  provider = \"mysql\"\n}\n\n// ==================== 枚举 ====================\n\n// 用户角色：区分客户端用户与员工端用户\nenum UserRole {\n  CUSTOMER // 客户端用户\n  EMPLOYEE // 员工端用户\n}\n\n// 性别\nenum Gender {\n  MALE\n  FEMALE\n}\n\n// 后台管理员角色：控制后台菜单、操作和数据范围\nenum AdminRole {\n  SUPER_ADMIN // 超级管理员\n  CONTENT_OPERATOR // 内容运营\n  CUSTOMER_SERVICE // 客户服务\n}\n\n// 发布状态：用于案例、焕新方案、商品和轮播图\nenum PublishStatus {\n  DRAFT // 草稿\n  PUBLISHED // 已发布\n  OFFLINE // 已下线\n}\n\n// 预约类型：统一表示预算、量房、报价及各类咨询线索\nenum AppointmentType {\n  BUDGET // 装修预算\n  MEASURE // 免费量房\n  QUOTE // 房屋报价\n  PLAN // 焕新方案预约\n  CASE // 同款案例报价\n  OUTLET // 网点咨询\n}\n\n// 装修预约状态\nenum AppointmentStatus {\n  PENDING_CONTACT // 待联系\n  PENDING_VISIT // 待上门\n  COMPLETED // 已完成\n  CANCELED // 已取消\n}\n\n// 装修项目状态\nenum RenovationProjectStatus {\n  PENDING_QUOTE // 提交报价 --- 操作人：员工\n  PENDING_CONFIRM // 待确认 --- 操作人：客户\n  IN_SERVICE // 服务中 \n  COMPLETED // 已完成 --- 操作人：员工\n  CANCELED // 已取消\n}\n\n// 商品订单业务状态\nenum ProductOrderStatus {\n  PENDING_PAYMENT // 待付款\n  PENDING_INSTALLATION // 待安装\n  IN_SERVICE // 服务中\n  COMPLETED // 已完成\n  CANCELED // 已取消\n  REFUNDING // 退款中\n  REFUNDED // 已退款\n  PENDING_CONFIRMATION // 安装已完工，待客户确认\n}\n\n// 商品订单最终完成方式；历史订单允许为空。\nenum OrderCompletionType {\n  CUSTOMER_CONFIRMED // 客户主动确认\n  AUTO_TIMEOUT // 超时自动完成\n}\n\n// 商品订单支付与退款状态\nenum PaymentStatus {\n  UNPAID // 未支付\n  PAID // 已支付\n  REFUNDING // 退款中\n  REFUNDED // 已退款\n  CLOSED // 已关闭\n}\n\n// 安装服务单状态\nenum InstallationStatus {\n  PENDING_APPOINTMENT // 待预约\n  PENDING_ASSIGNMENT // 待派单\n  PENDING_VISIT // 待上门\n  IN_SERVICE // 服务中\n  COMPLETED // 已完成\n  CANCELED // 已取消\n}\n\n// 库存变动类型\nenum StockChangeType {\n  INBOUND // 入库\n  SALE // 销售出库\n  CANCEL_RELEASE // 取消订单释放库存\n  MANUAL // 人工调整\n}\n\n// 积分变动类型\nenum PointChangeType {\n  INCOME // 积分收入\n  EXPENSE // 积分支出\n  MANUAL // 人工调整\n  EXPIRED // 积分过期\n}\n\n// 优惠券适用业务范围\nenum CouponScopeType {\n  ALL // 全部\n  RENOVATION // 装修\n  PRODUCT // 商品\n}\n\n// 优惠券模板状态\nenum CouponStatus {\n  DRAFT // 草稿\n  PUBLISHED // 已发布\n  DISABLED // 已停用\n}\n\n// 用户优惠券状态\nenum UserCouponStatus {\n  AVAILABLE // 可使用\n  USED // 已使用\n  EXPIRED // 已过期\n  INVALID // 已失效\n}\n\n// 意见反馈处理状态\nenum FeedbackStatus {\n  PENDING // 待处理\n  PROCESSING // 处理中\n  REPLIED // 已回复\n  CLOSED // 已关闭\n}\n\n// 消息通知发送渠道\nenum NotificationChannel {\n  SMS // 短信\n  SUBSCRIBE_MESSAGE // 微信订阅消息\n  IN_APP // 站内消息\n}\n\n// 消息发送状态\nenum SendStatus {\n  PENDING // 待发送\n  SUCCESS // 发送成功\n  FAILED // 发送失败\n}\n\n// ==================== 账号与人员 ====================\n\n// 用户表：保存客户和员工共用的登录账号及会员资产汇总\nmodel User {\n  /// 主键 ID\n  id                Int      @id @default(autoincrement())\n  /// 用户编号\n  userNo            String   @unique @map(\"user_no\") @db.VarChar(64)\n  /// 角色\n  role              UserRole @default(CUSTOMER)\n  /// 手机号码\n  mobile            String   @unique @db.VarChar(20)\n  /// 密码哈希\n  password          String?\n  /// 微信 OpenID\n  openid            String?  @unique @db.VarChar(128)\n  /// 昵称\n  nickname          String?\n  /// 真实姓名\n  realName          String?  @map(\"real_name\")\n  /// 性别\n  gender            Gender   @default(MALE)\n  /// 头像地址\n  avatar            String?\n  /// 来源渠道\n  source            String?\n  /// 所在城市\n  city              String?\n  /// 标签列表\n  tags              Json?\n  /// 当前可用积分\n  points            Int      @default(0)\n  /// 待追回积分，独立于可用余额\n  pointDebt         Int      @default(0) @map(\"point_debt\")\n  /// 累计获得积分\n  totalPointsEarned Int      @default(0) @map(\"total_points_earned\")\n  /// 累计使用积分\n  totalPointsUsed   Int      @default(0) @map(\"total_points_used\")\n  /// 用户账号是否启用\n  status            Boolean  @default(true)\n  /// 创建时间\n  createdAt         DateTime @default(now()) @map(\"created_at\")\n  /// 更新时间\n  updatedAt         DateTime @updatedAt @map(\"updated_at\")\n\n  /// 关联员工档案\n  employee           Employee?\n  /// 关联服务地址列表\n  addresses          Address[]\n  /// 关联购物车明细\n  cartItems          CartItem[]\n  /// 关联案例收藏列表\n  favorites          Favorite[]\n  /// 关联预约列表\n  appointments       Appointment[]\n  /// 关联装修项目列表\n  renovationProjects RenovationProject[]\n  /// 关联商品订单列表\n  productOrders      ProductOrder[]\n  /// 关联积分流水列表\n  pointRecords       PointRecord[]\n  /// 关联用户优惠券列表\n  userCoupons        UserCoupon[]\n  /// 关联意见反馈列表\n  feedbacks          Feedback[]\n  /// 关联消息通知列表\n  notifications      Notification[]\n\n  @@index([role, status])\n  @@index([createdAt])\n  @@map(\"user\")\n}\n\n// 员工表：保存员工身份、岗位、部门及服务范围\nmodel Employee {\n  /// 主键 ID\n  id             Int       @id @default(autoincrement())\n  /// 关联用户 ID\n  userId         Int       @unique @map(\"user_id\")\n  /// 员工编号\n  employeeNo     String    @unique @map(\"employee_no\") @db.VarChar(64)\n  /// 岗位\n  position       String?\n  /// 所属部门\n  department     String?   @db.VarChar(100)\n  /// 服务区域列表\n  serviceRegions Json?     @map(\"service_regions\")\n  /// 入职时间\n  hiredAt        DateTime? @map(\"hired_at\")\n  /// 是否在职或可用\n  status         Boolean   @default(true)\n  /// 创建时间\n  createdAt      DateTime  @default(now()) @map(\"created_at\")\n  /// 更新时间\n  updatedAt      DateTime  @updatedAt @map(\"updated_at\")\n\n  /// 关联员工登录账号\n  user               User                @relation(fields: [userId], references: [id])\n  /// 关联预约列表\n  appointments       Appointment[]\n  /// 关联装修项目列表\n  renovationProjects RenovationProject[]\n  /// 关联安装服务单列表\n  installationOrders InstallationOrder[]\n  /// 关联跟进记录列表\n  followUps          FollowUp[]\n\n  @@index([department, status])\n  @@map(\"employee\")\n}\n\n// 后台管理员表：保存管理后台账号、角色及权限\nmodel Admin {\n  /// 主键 ID\n  id          Int       @id @default(autoincrement())\n  /// 管理员登录名\n  username    String    @unique @db.VarChar(100)\n  /// 密码哈希\n  password    String\n  /// 名称\n  name        String?\n  /// 手机号码\n  mobile      String?\n  /// 角色\n  role        AdminRole @default(CUSTOMER_SERVICE)\n  /// 权限配置\n  permissions Json?\n  /// 数据权限范围\n  dataScope   Json?     @map(\"data_scope\")\n  /// 管理员账号是否启用\n  status      Boolean   @default(true)\n  /// 最后登录时间\n  lastLoginAt DateTime? @map(\"last_login_at\")\n  /// 创建时间\n  createdAt   DateTime  @default(now()) @map(\"created_at\")\n  /// 更新时间\n  updatedAt   DateTime  @updatedAt @map(\"updated_at\")\n\n  /// 关联意见反馈列表\n  feedbacks     Feedback[]\n  /// 关联操作日志列表\n  operationLogs OperationLog[]\n  /// 最近由该管理员修改的积分规则\n  pointRules    PointRule[]\n\n  @@map(\"admin\")\n}\n\n// 服务地址表：保存客户的收货及上门服务地址\nmodel Address {\n  /// 主键 ID\n  id           Int      @id @default(autoincrement())\n  /// 关联用户 ID\n  userId       Int      @map(\"user_id\")\n  /// 联系人姓名\n  contactName  String   @map(\"contact_name\")\n  /// 联系电话\n  phone        String\n  /// 地图位置名称\n  locationName String?  @map(\"location_name\")\n  /// 省份\n  province     String?\n  /// 所在城市\n  city         String?\n  /// 区县\n  district     String?\n  /// 详细地址\n  address      String\n  /// 门牌号\n  doorplate    String?\n  /// 纬度\n  latitude     Decimal? @db.Decimal(10, 7)\n  /// 经度\n  longitude    Decimal? @db.Decimal(10, 7)\n  /// 是否为默认地址\n  isDefault    Boolean  @default(false) @map(\"is_default\")\n  /// 是否启用\n  isEnabled    Boolean  @default(true) @map(\"is_enabled\")\n  /// 创建时间\n  createdAt    DateTime @default(now()) @map(\"created_at\")\n  /// 更新时间\n  updatedAt    DateTime @updatedAt @map(\"updated_at\")\n\n  /// 关联地址所属用户\n  user User @relation(fields: [userId], references: [id])\n\n  @@index([userId, isDefault])\n  @@map(\"address\")\n}\n\n// ==================== 内容 ====================\n\n// 案例分类表：维护装修案例的分类、排序和启停状态\nmodel CaseCategory {\n  /// 主键 ID\n  id        Int      @id @default(autoincrement())\n  /// 分类名称\n  name      String\n  /// 显示排序\n  sort      Int      @default(0)\n  /// 是否启用\n  isEnabled Boolean  @default(true) @map(\"is_enabled\")\n  /// 创建时间\n  createdAt DateTime @default(now()) @map(\"created_at\")\n  /// 更新时间\n  updatedAt DateTime @updatedAt @map(\"updated_at\")\n\n  /// 关联装修案例列表\n  cases RenovationCase[]\n\n  @@index([isEnabled, sort])\n  @@map(\"case_category\")\n}\n\n// 装修案例表：保存改造案例内容、费用及推荐信息\nmodel RenovationCase {\n  /// 主键 ID\n  id            Int           @id @default(autoincrement())\n  /// 案例分类 ID\n  categoryId    Int           @map(\"category_id\")\n  /// 标题\n  title         String\n  /// 标签列表\n  tags          Json?\n  /// 所在城市\n  city          String?       @db.VarChar(100)\n  /// 户型\n  roomType      String?       @map(\"room_type\")\n  /// 面积（平方米）\n  area          Decimal?      @db.Decimal(8, 2)\n  /// 装修风格\n  style         String?\n  /// 改造前图片列表\n  beforeImage   String        @map(\"before_images\")\n  /// 改造后图片列表\n  afterImage    String        @map(\"after_images\")\n  /// 描述\n  description   String?       @db.Text\n  /// 改造亮点列表\n  highlights    Json?\n  /// 费用组成列表\n  costs         Json?\n  /// 总价\n  totalPrice    Decimal?      @map(\"total_price\") @db.Decimal(10, 2)\n  /// 工期天数\n  durationDays  Int?          @map(\"duration_days\")\n  /// 浏览次数\n  viewCount     Int           @default(0) @map(\"view_count\")\n  /// 报价咨询次数\n  quoteCount    Int           @default(0) @map(\"quote_count\")\n  /// 分享标题\n  shareTitle    String?       @map(\"share_title\")\n  /// 分享图片\n  shareImage    String?       @map(\"share_image\")\n  /// 是否推荐\n  isRecommended Boolean       @default(false) @map(\"is_recommended\")\n  /// 推荐排序\n  recommendSort Int           @default(0) @map(\"recommend_sort\")\n  /// 发布状态\n  status        PublishStatus @default(DRAFT)\n  /// 创建时间\n  createdAt     DateTime      @default(now()) @map(\"created_at\")\n  /// 更新时间\n  updatedAt     DateTime      @updatedAt @map(\"updated_at\")\n\n  /// 关联案例分类\n  category     CaseCategory  @relation(fields: [categoryId], references: [id])\n  /// 关联案例收藏列表\n  favorites    Favorite[]\n  /// 关联预约列表\n  appointments Appointment[]\n\n  @@index([status, isRecommended, recommendSort])\n  @@index([categoryId, city])\n  @@map(\"renovation_case\")\n}\n\n// 焕新方案表：保存空间焕新方案的基础内容和价格\nmodel RenewalPlan {\n  /// 主键 ID\n  id            Int           @id @default(autoincrement())\n  /// 焕新方案名称\n  name          String\n  /// 简介\n  summary       String?\n  /// 标签列表\n  tags          Json?\n  /// 起步价\n  startingPrice Decimal       @map(\"starting_price\") @db.Decimal(10, 2)\n  /// 封面图片\n  cover         Json\n  /// 详情内容\n  detail        Json\n  /// 分享标题\n  shareTitle    String?       @map(\"share_title\")\n  /// 分享图片\n  shareImage    String?       @map(\"share_image\")\n  /// 排序值\n  sort          Int           @default(0)\n  /// 是否推荐\n  isRecommended Boolean       @default(false) @map(\"is_recommended\")\n  /// 推荐排序\n  recommendSort Int           @default(0) @map(\"recommend_sort\")\n  /// 发布状态\n  status        PublishStatus @default(DRAFT)\n  /// 创建时间\n  createdAt     DateTime      @default(now()) @map(\"created_at\")\n  /// 更新时间\n  updatedAt     DateTime      @updatedAt @map(\"updated_at\")\n\n  /// 关联服务项目列表\n  items        RenewalPlanItem[]\n  /// 关联预约列表\n  appointments Appointment[]\n  /// 关联装修项目列表\n  projects     RenovationProject[]\n\n  @@index([status, isRecommended, recommendSort])\n  @@index([status, sort])\n  @@map(\"renewal_plan\")\n}\n\n// 焕新方案服务项目表：保存方案中的主材、人工和辅材明细\nmodel RenewalPlanItem {\n  /// 主键 ID\n  id          Int     @id @default(autoincrement())\n  /// 关联焕新方案 ID\n  planId      Int     @map(\"plan_id\")\n  /// 关联商品 ID\n  productId   Int?    @map(\"product_id\")\n  /// 服务项目分类\n  category    String\n  /// 服务项目名称\n  name        String\n  /// 描述\n  description String?\n  /// 计价单位\n  unit        String\n  /// 单价\n  unitPrice   Decimal @map(\"unit_price\") @db.Decimal(10, 2)\n  /// 数量\n  quantity    Decimal @default(1) @db.Decimal(10, 2)\n  /// 图片地址\n  image       String?\n  /// 排序值\n  sort        Int     @default(0)\n\n  /// 关联焕新方案\n  plan    RenewalPlan @relation(fields: [planId], references: [id], onDelete: Cascade)\n  /// 关联商品\n  product Product?    @relation(fields: [productId], references: [id])\n\n  @@index([planId, sort])\n  @@map(\"renewal_plan_item\")\n}\n\n// 轮播图表：保存首页轮播内容、跳转目标及有效期\nmodel Banner {\n  /// 主键 ID\n  id         Int           @id @default(autoincrement())\n  /// 标题\n  title      String\n  /// 图片地址\n  image      String\n  /// 跳转目标类型\n  targetType String?       @map(\"target_type\")\n  /// 跳转目标\n  target     String?\n  /// 排序值\n  sort       Int           @default(0)\n  /// 发布状态\n  status     PublishStatus @default(DRAFT)\n  /// 创建时间\n  createdAt  DateTime      @default(now()) @map(\"created_at\")\n  /// 更新时间\n  updatedAt  DateTime      @updatedAt @map(\"updated_at\")\n\n  @@index([status, sort])\n  @@map(\"banner\")\n}\n\n// 案例收藏表：记录用户收藏的装修案例\nmodel Favorite {\n  /// 主键 ID\n  id        Int      @id @default(autoincrement())\n  /// 关联用户 ID\n  userId    Int      @map(\"user_id\")\n  /// 关联装修案例 ID\n  caseId    Int      @map(\"case_id\")\n  /// 创建时间\n  createdAt DateTime @default(now()) @map(\"created_at\")\n\n  /// 关联用户\n  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)\n  /// 关联装修案例\n  case RenovationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)\n\n  @@unique([userId, caseId])\n  @@map(\"favorite\")\n}\n\n// ==================== 施工服务 ====================\n\n// 施工服务表：保存保护、拆除、保洁、防水和安装等按单位计价的服务\nmodel ConstructionService {\n  quoteItems  ProjectQuoteItem[]\n  /// 主键 ID\n  id          Int                @id @default(autoincrement())\n  /// 服务名称\n  name        String             @db.VarChar(255)\n  /// 服务内容或适用范围\n  description String?            @db.VarChar(500)\n  /// 计价单位，例如：㎡、项、个\n  unit        String             @db.VarChar(32)\n  /// 基础单价\n  unitPrice   Decimal            @map(\"unit_price\") @db.Decimal(10, 2)\n  /// 服务图片\n  image       String?            @db.VarChar(500)\n  /// 是否启用\n  isEnabled   Boolean            @default(true) @map(\"is_enabled\")\n  /// 排序值，数值越小越靠前\n  sort        Int                @default(0)\n  /// 创建时间\n  createdAt   DateTime           @default(now()) @map(\"created_at\")\n  /// 更新时间\n  updatedAt   DateTime           @updatedAt @map(\"updated_at\")\n\n  @@index([isEnabled, sort])\n  @@map(\"construction_service\")\n}\n\n// ==================== 商品 ====================\n\n// 商品分类表：保存一级、二级商品分类树\nmodel ProductCategory {\n  /// 主键 ID\n  id        Int      @id @default(autoincrement())\n  /// 父分类 ID\n  parentId  Int?     @map(\"parent_id\")\n  /// 分类名称\n  name      String\n  /// 排序值\n  sort      Int      @default(0)\n  /// 是否启用\n  isEnabled Boolean  @default(true) @map(\"is_enabled\")\n  /// 创建时间\n  createdAt DateTime @default(now()) @map(\"created_at\")\n  /// 更新时间\n  updatedAt DateTime @updatedAt @map(\"updated_at\")\n\n  /// 关联父分类\n  parent   ProductCategory?  @relation(\"CategoryTree\", fields: [parentId], references: [id])\n  /// 关联子分类列表\n  children ProductCategory[] @relation(\"CategoryTree\")\n  /// 关联商品列表\n  products Product[]\n\n  @@index([parentId, sort])\n  @@map(\"product_category\")\n}\n\n// 商品表：保存商品公共信息，规格、售价和库存由 SKU 管理\nmodel Product {\n  /// 主键 ID\n  id                   Int      @id @default(autoincrement())\n  /// 商品分类 ID\n  categoryId           Int      @map(\"category_id\")\n  /// 商品名称\n  name                 String   @db.VarChar(255)\n  unit                 String   @default(\"件\") @db.VarChar(32)\n  /// 商品描述或卖点\n  description          String?  @db.VarChar(500)\n  /// 品牌，例如：九牧JOMOO\n  brand                String?  @db.VarChar(100)\n  /// 产品型号，例如：X32025-548/1B-Z\n  model                String?  @db.VarChar(100)\n  /// 商品主图数组，按轮播顺序排列，第一张作为封面\n  mainImage            Json     @map(\"main_image\")\n  /// 商品详情图片，例如：\n  /// [\"图片地址1\", \"图片地址2\"]\n  detailImages         Json?    @map(\"detail_images\")\n  /// 是否包含基础安装\n  installationIncluded Boolean  @default(true) @map(\"installation_included\")\n  /// 是否上架\n  isPublished          Boolean  @default(false) @map(\"is_published\")\n  /// 后台排序，数值越小越靠前\n  sort                 Int      @default(0)\n  /// 创建时间\n  createdAt            DateTime @default(now()) @map(\"created_at\")\n  /// 更新时间\n  updatedAt            DateTime @updatedAt @map(\"updated_at\")\n\n  /// 分类\n  category   ProductCategory    @relation(fields: [categoryId], references: [id])\n  skus       ProductSku[]\n  /// 关联购物车明细\n  cartItems  CartItem[]\n  /// 关联订单明细列表\n  orderItems ProductOrderItem[]\n  /// 关联库存流水列表\n  stockLogs  StockLog[]\n  /// 关联焕新方案服务项目列表\n  planItems  RenewalPlanItem[]\n  /// 关联项目报价明细列表\n  quoteItems ProjectQuoteItem[]\n\n  @@index([categoryId])\n  @@index([isPublished, sort])\n  @@map(\"product\")\n}\n\nmodel ProductSku {\n  id        Int       @id @default(autoincrement())\n  productId Int       @map(\"product_id\")\n  name      String    @db.VarChar(255)\n  price     Decimal   @db.Decimal(10, 2)\n  stock     Int       @default(0)\n  isEnabled Boolean   @default(true) @map(\"is_enabled\")\n  deletedAt DateTime? @map(\"deleted_at\")\n  sort      Int       @default(0)\n  createdAt DateTime  @default(now()) @map(\"created_at\")\n  updatedAt DateTime  @updatedAt @map(\"updated_at\")\n\n  product    Product            @relation(fields: [productId], references: [id], onDelete: Restrict)\n  cartItems  CartItem[]\n  stockLogs  StockLog[]\n  orderItems ProductOrderItem[]\n\n  @@index([productId, name])\n  @@index([productId, isEnabled, sort])\n  @@map(\"product_sku\")\n}\n\n// 购物车明细表：保存用户加入购物车的商品和数量\nmodel CartItem {\n  skuId     Int        @map(\"sku_id\")\n  sku       ProductSku @relation(fields: [skuId], references: [id], onDelete: Restrict)\n  /// 主键 ID\n  id        Int        @id @default(autoincrement())\n  /// 关联用户 ID\n  userId    Int        @map(\"user_id\")\n  /// 关联商品 ID\n  productId Int        @map(\"product_id\")\n  /// 数量\n  quantity  Int        @default(1)\n  /// 是否选中\n  selected  Boolean    @default(true)\n  /// 创建时间\n  createdAt DateTime   @default(now()) @map(\"created_at\")\n  /// 更新时间\n  updatedAt DateTime   @updatedAt @map(\"updated_at\")\n\n  /// 关联用户\n  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)\n  /// 关联商品\n  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)\n\n  @@unique([userId, skuId])\n  @@map(\"cart_item\")\n}\n\n// 库存流水表：记录入库、销售、取消释放及人工调整\nmodel StockLog {\n  skuId     Int             @map(\"sku_id\")\n  sku       ProductSku      @relation(fields: [skuId], references: [id], onDelete: Restrict)\n  /// 主键 ID\n  id        Int             @id @default(autoincrement())\n  /// 关联商品 ID\n  productId Int             @map(\"product_id\")\n  /// 库存变动类型\n  type      StockChangeType\n  /// 变动数量\n  change    Int\n  /// 变动后的库存数量\n  stock     Int\n  /// 变动原因\n  reason    String?\n  /// 关联业务编号\n  relatedNo String?         @map(\"related_no\")\n  /// 操作人\n  operator  String?\n  /// 创建时间\n  createdAt DateTime        @default(now()) @map(\"created_at\")\n\n  /// 关联商品\n  product Product @relation(fields: [productId], references: [id])\n\n  @@index([productId, createdAt])\n  @@index([skuId, createdAt])\n  @@map(\"stock_log\")\n}\n\n// ==================== 装修业务 ====================\n\n// 装修预约表：统一保存预算、量房、报价和咨询预约\nmodel Appointment {\n  /// 主键 ID\n  id                  Int               @id @default(autoincrement())\n  /// 预约编号\n  appointmentNo       String            @unique @map(\"appointment_no\") @db.VarChar(64)\n  /// 关联用户 ID\n  userId              Int?              @map(\"user_id\")\n  /// 负责员工 ID\n  employeeId          Int?              @map(\"employee_id\")\n  /// 关联装修案例 ID\n  caseId              Int?              @map(\"case_id\")\n  /// 关联焕新方案 ID\n  planId              Int?              @map(\"plan_id\")\n  /// 预约类型\n  type                AppointmentType\n  /// 来源渠道\n  source              String?\n  /// 客户姓名\n  customerName        String?           @map(\"customer_name\")\n  /// 手机号码\n  mobile              String            @db.VarChar(20)\n  /// 房屋类型\n  houseType           String?           @map(\"house_type\")\n  /// 所在城市\n  city                String?\n  /// 面积（平方米）\n  area                Decimal?          @db.Decimal(8, 2)\n  /// 户型布局\n  roomLayout          String?           @map(\"room_layout\")\n  /// 装修需求\n  demand              String?           @db.Text\n  /// 预约提交时的方案及明细快照\n  snapshot            Json?\n  /// 关注重点\n  focus               String?\n  /// 上门日期\n  visitDate           DateTime?         @map(\"visit_date\")\n  /// 预约时段\n  timeSlot            String?           @map(\"time_slot\")\n  /// 上门地址\n  visitAddress        String?           @map(\"visit_address\")\n  /// 预约状态\n  status              AppointmentStatus @default(PENDING_CONTACT)\n  /// 上门测量后的参考预估金额，不等于项目实际报价\n  estimatedAmount     Decimal?          @map(\"estimated_amount\") @db.Decimal(10, 2)\n  /// 预估报价说明\n  estimateDescription String?           @map(\"estimate_description\") @db.VarChar(191)\n  /// 预估报价提交时间\n  estimatedAt         DateTime?         @map(\"estimated_at\")\n  /// 完成时间\n  completedAt         DateTime?         @map(\"completed_at\")\n  /// 取消时间\n  canceledAt          DateTime?         @map(\"canceled_at\")\n  /// 创建时间\n  createdAt           DateTime          @default(now()) @map(\"created_at\")\n  /// 更新时间\n  updatedAt           DateTime          @updatedAt @map(\"updated_at\")\n\n  /// 关联用户\n  user      User?              @relation(fields: [userId], references: [id])\n  /// 关联员工档案\n  employee  Employee?          @relation(fields: [employeeId], references: [id])\n  /// 关联装修案例\n  case      RenovationCase?    @relation(fields: [caseId], references: [id])\n  /// 关联焕新方案\n  plan      RenewalPlan?       @relation(fields: [planId], references: [id])\n  /// 关联跟进记录列表\n  followUps FollowUp[]\n  /// 关联装修项目\n  project   RenovationProject?\n\n  @@index([status, employeeId])\n  @@index([mobile])\n  @@index([createdAt])\n  @@map(\"appointment\")\n}\n\n// 跟进记录表：保存预约或装修项目的沟通跟进内容\nmodel FollowUp {\n  /// 主键 ID\n  id            Int       @id @default(autoincrement())\n  /// 关联预约 ID\n  appointmentId Int?      @map(\"appointment_id\")\n  /// 关联装修项目 ID\n  projectId     Int?      @map(\"project_id\")\n  /// 负责员工 ID\n  employeeId    Int?      @map(\"employee_id\")\n  /// 内容\n  content       String    @db.Text\n  /// 下次跟进时间\n  nextFollowAt  DateTime? @map(\"next_follow_at\")\n  /// 创建时间\n  createdAt     DateTime  @default(now()) @map(\"created_at\")\n\n  /// 关联来源预约\n  appointment Appointment?       @relation(fields: [appointmentId], references: [id], onDelete: Cascade)\n  /// 关联装修项目\n  project     RenovationProject? @relation(fields: [projectId], references: [id], onDelete: Cascade)\n  /// 关联跟进员工\n  employee    Employee?          @relation(fields: [employeeId], references: [id])\n\n  @@index([appointmentId, createdAt])\n  @@index([projectId, createdAt])\n  @@map(\"follow_up\")\n}\n\n// 装修项目表：保存由预约转化的装修项目及成交信息\nmodel RenovationProject {\n  /// 计划完成日期，当日结束后未完成视为逾期\n  plannedCompletionDate DateTime?               @map(\"planned_completion_date\") @db.Date\n  /// 后台项目备注与最新进度摘要\n  remark                String                  @default(\"\") @db.VarChar(5000)\n  progress              String                  @default(\"\") @db.VarChar(5000)\n  /// 主键 ID\n  id                    Int                     @id @default(autoincrement())\n  /// 装修项目编号\n  projectNo             String                  @unique @map(\"project_no\") @db.VarChar(64)\n  /// 关联预约 ID\n  appointmentId         Int?                    @unique @map(\"appointment_id\")\n  /// 关联用户 ID\n  userId                Int?                    @map(\"user_id\")\n  /// 负责员工 ID\n  employeeId            Int?                    @map(\"employee_id\")\n  /// 关联方案 ID\n  planId                Int?                    @map(\"plan_id\")\n  /// 装修项目名称\n  name                  String\n  /// 客户姓名\n  customerName          String                  @map(\"customer_name\")\n  /// 手机号码\n  mobile                String\n  /// 服务地址快照\n  serviceAddress        String                  @map(\"service_address\")\n  /// 当前报价金额\n  quotedAmount          Decimal                 @default(0) @map(\"quoted_amount\") @db.Decimal(10, 2)\n  /// 每次修改报价时递增，确认时校验客户端版本\n  quoteVersion          Int                     @default(1) @map(\"quote_version\")\n  /// 最近一次报价修改备注\n  quoteRemark           String?                 @map(\"quote_remark\") @db.VarChar(500)\n  /// 合同成交金额\n  contractAmount        Decimal?                @map(\"contract_amount\") @db.Decimal(10, 2)\n  /// 客户或后台首次确认成交的时间\n  couponDiscount        Decimal                 @default(0) @map(\"coupon_discount\") @db.Decimal(10, 2)\n  couponSnapshot        Json?                   @map(\"coupon_snapshot\")\n  couponReturnedAt      DateTime?               @map(\"coupon_returned_at\")\n  userCoupon            UserCoupon?\n  quoteConfirmedAt      DateTime?               @map(\"quote_confirmed_at\")\n  /// 装修项目状态\n  status                RenovationProjectStatus @default(PENDING_CONFIRM)\n  /// 取消原因与操作时间\n  cancelReason          String?                 @map(\"cancel_reason\") @db.VarChar(500)\n  canceledAt            DateTime?               @map(\"canceled_at\")\n  /// 取消操作者员工 ID 快照，保留审计信息，不随负责人变更\n  canceledByEmployeeId  Int?                    @map(\"canceled_by_employee_id\")\n  /// 完成时间\n  completedAt           DateTime?               @map(\"completed_at\")\n  /// 创建时间\n  createdAt             DateTime                @default(now()) @map(\"created_at\")\n  /// 更新时间\n  updatedAt             DateTime                @updatedAt @map(\"updated_at\")\n\n  /// 关联来源预约\n  appointment Appointment?       @relation(fields: [appointmentId], references: [id])\n  /// 关联用户\n  user        User?              @relation(fields: [userId], references: [id])\n  /// 关联员工档案\n  employee    Employee?          @relation(fields: [employeeId], references: [id])\n  /// 关联焕新方案\n  plan        RenewalPlan?       @relation(fields: [planId], references: [id])\n  /// 关联项目报价明细列表\n  quoteItems  ProjectQuoteItem[]\n  /// 关联项目进度列表\n  progresses  ProjectProgress[]\n  /// 关联跟进记录列表\n  followUps   FollowUp[]\n\n  @@index([status, employeeId])\n  @@index([userId, createdAt])\n  @@index([employeeId, status, quoteConfirmedAt], map: \"project_employee_status_confirmed_idx\")\n  @@index([status, completedAt, employeeId], map: \"project_status_completed_employee_idx\")\n  @@index([status, plannedCompletionDate], map: \"project_status_planned_completion_idx\")\n  @@map(\"renovation_project\")\n}\n\n// 项目报价明细表：保存装修项目的主材、人工和辅材报价\nmodel ProjectQuoteItem {\n  /// 可选施工服务关联；与商品关联互斥\n  serviceId   Int?                 @map(\"service_id\")\n  service     ConstructionService? @relation(fields: [serviceId], references: [id], onDelete: Restrict)\n  /// 主键 ID\n  id          Int                  @id @default(autoincrement())\n  /// 关联装修项目 ID\n  projectId   Int                  @map(\"project_id\")\n  /// 关联商品 ID\n  productId   Int?                 @map(\"product_id\")\n  /// 报价项目分类\n  category    String\n  /// 报价项目名称\n  name        String\n  /// 描述\n  description String?\n  /// 计价单位\n  unit        String\n  /// 单价\n  unitPrice   Decimal              @map(\"unit_price\") @db.Decimal(10, 2)\n  /// 数量\n  quantity    Decimal              @default(1) @db.Decimal(10, 2)\n  /// 图片地址\n  image       String?\n  /// 排序值\n  sort        Int                  @default(0)\n  /// 创建时间\n  createdAt   DateTime             @default(now()) @map(\"created_at\")\n  /// 更新时间\n  updatedAt   DateTime             @updatedAt @map(\"updated_at\")\n\n  /// 关联装修项目\n  project RenovationProject @relation(fields: [projectId], references: [id], onDelete: Cascade)\n  /// 关联商品\n  product Product?          @relation(fields: [productId], references: [id])\n\n  @@index([serviceId])\n  @@index([projectId, sort])\n  @@map(\"project_quote_item\")\n}\n\n// 项目进度表：记录装修项目各阶段的进度说明和图片\nmodel ProjectProgress {\n  /// 主键 ID\n  id        Int                     @id @default(autoincrement())\n  /// 关联装修项目 ID\n  projectId Int                     @map(\"project_id\")\n  /// 本次进度状态\n  status    RenovationProjectStatus\n  /// 内容\n  content   String?\n  /// 图片列表\n  images    Json?\n  /// 创建人\n  createdBy String?                 @map(\"created_by\")\n  /// 创建时间\n  createdAt DateTime                @default(now()) @map(\"created_at\")\n\n  /// 关联装修项目\n  project RenovationProject @relation(fields: [projectId], references: [id], onDelete: Cascade)\n\n  @@index([projectId, createdAt])\n  @@map(\"project_progress\")\n}\n\n// ==================== 商品交易 ====================\n\n// 商品订单表：保存订单金额、支付、退款及履约状态\nmodel ProductOrder {\n  /// 超时关闭原因；手动取消及历史记录为空\n  cancelReason           String?              @map(\"cancel_reason\") @db.VarChar(100)\n  /// 客户确认截止时间，安装完工后开始计算\n  confirmationDeadlineAt DateTime?            @map(\"confirmation_deadline_at\")\n  /// 订单最终完成方式，历史订单为空\n  completionType         OrderCompletionType? @map(\"completion_type\")\n  /// 线下争议处理期间暂停自动完成\n  autoCompletionPaused   Boolean              @default(false) @map(\"auto_completion_paused\")\n  /// Installation booking selected before payment; nullable for legacy orders.\n  appointmentDate        DateTime?            @map(\"appointment_date\") @db.Date\n\n  timeSlot        String?            @map(\"time_slot\") @db.VarChar(11)\n  /// 主键 ID\n  id              Int                @id @default(autoincrement())\n  /// 商品订单编号\n  orderNo         String             @unique @map(\"order_no\") @db.VarChar(64)\n  /// 关联用户 ID\n  userId          Int                @map(\"user_id\")\n  /// 来源渠道\n  source          String?\n  /// 联系人姓名\n  contactName     String             @map(\"contact_name\")\n  /// 联系电话快照\n  contactPhone    String             @map(\"contact_phone\")\n  /// 服务地址快照\n  serviceAddress  String             @map(\"service_address\")\n  /// 用户备注\n  remark          String?\n  /// 商品总金额\n  productAmount   Decimal            @map(\"product_amount\") @db.Decimal(10, 2)\n  /// 优惠券抵扣金额\n  couponDiscount  Decimal            @default(0) @map(\"coupon_discount\") @db.Decimal(10, 2)\n  /// 积分抵扣金额\n  pointDiscount   Decimal            @default(0) @map(\"point_discount\") @db.Decimal(10, 2)\n  /// 使用积分数量\n  pointsUsed      Int                @default(0) @map(\"points_used\")\n  /// 安装费用\n  installationFee Decimal?           @default(0) @map(\"installation_fee\") @db.Decimal(10, 2)\n  /// 应付金额\n  payableAmount   Decimal            @map(\"payable_amount\") @db.Decimal(10, 2)\n  /// 实付金额\n  paidAmount      Decimal            @default(0) @map(\"paid_amount\") @db.Decimal(10, 2)\n  /// 退款金额\n  refundAmount    Decimal?           @default(0) @map(\"refund_amount\") @db.Decimal(10, 2)\n  /// 商品订单状态\n  status          ProductOrderStatus @default(PENDING_PAYMENT)\n  /// 支付状态\n  paymentStatus   PaymentStatus      @default(UNPAID) @map(\"payment_status\")\n  /// 支付方式\n  paymentMethod   String?            @map(\"payment_method\")\n  /// 支付流水号\n  paymentNo       String?            @map(\"payment_no\") @db.VarChar(100)\n  /// 支付时间\n  paidAt          DateTime?          @map(\"paid_at\")\n  /// 取消时间\n  canceledAt      DateTime?          @map(\"canceled_at\")\n  /// 完成时间\n  completedAt     DateTime?          @map(\"completed_at\")\n  /// 创建时间\n  createdAt       DateTime           @default(now()) @map(\"created_at\")\n  /// 更新时间\n  updatedAt       DateTime           @updatedAt @map(\"updated_at\")\n\n  /// 关联用户\n  user         User               @relation(fields: [userId], references: [id])\n  /// 关联订单明细列表\n  items        ProductOrderItem[]\n  /// 关联安装服务单\n  installation InstallationOrder?\n  /// 本订单使用的用户优惠券\n  userCoupon   UserCoupon?\n\n  @@index([userId, status])\n  @@index([status, createdAt])\n  @@index([paymentNo])\n  @@index([status, confirmationDeadlineAt])\n  @@map(\"product_order\")\n}\n\n// 商品订单明细表：保存下单时的商品、规格和价格快照\nmodel ProductOrderItem {\n  skuId           Int        @map(\"sku_id\")\n  sku             ProductSku @relation(fields: [skuId], references: [id], onDelete: Restrict)\n  /// 主键 ID\n  id              Int        @id @default(autoincrement())\n  /// 关联商品订单 ID\n  orderId         Int        @map(\"order_id\")\n  /// 关联商品 ID\n  productId       Int?       @map(\"product_id\")\n  /// 商品名称快照\n  productName     String     @map(\"product_name\")\n  /// 规格描述快照\n  skuDescription  String?    @map(\"sku_description\")\n  /// 商品图片快照\n  image           String?\n  /// 成交单价\n  unitPrice       Decimal    @map(\"unit_price\") @db.Decimal(10, 2)\n  /// 数量\n  quantity        Int\n  /// 明细小计\n  subtotal        Decimal    @db.Decimal(10, 2)\n  /// 该商品是否需要安装\n  requiresInstall Boolean    @default(false) @map(\"requires_install\")\n  /// 明细安装费用\n  installationFee Decimal    @default(0) @map(\"installation_fee\") @db.Decimal(10, 2)\n\n  /// 关联商品订单\n  order   ProductOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)\n  /// 关联商品\n  product Product?     @relation(fields: [productId], references: [id])\n\n  @@index([orderId])\n  @@index([skuId])\n  @@index([productId])\n  @@map(\"product_order_item\")\n}\n\n// 安装服务单表：保存商品订单的安装预约及服务过程\nmodel InstallationOrder {\n  /// 预约时段结束时刻，按北京时间计算后保存 UTC\n  scheduledEndAt      DateTime?          @map(\"scheduled_end_at\")\n  /// 客户主动确认时间，与安装完工时间区分\n  customerConfirmedAt DateTime?          @map(\"customer_confirmed_at\")\n  /// 线下安装人员或团队名称，不关联员工账号\n  installerName       String?            @map(\"installer_name\") @db.VarChar(100)\n  /// 安装联系电话\n  installerPhone      String?            @map(\"installer_phone\") @db.VarChar(32)\n  /// 安装备注\n  remark              String?            @db.VarChar(1000)\n  /// 主键 ID\n  id                  Int                @id @default(autoincrement())\n  /// 安装服务单编号\n  serviceNo           String             @unique @map(\"service_no\") @db.VarChar(64)\n  /// 关联商品订单 ID\n  orderId             Int                @unique @map(\"order_id\")\n  /// 负责员工 ID\n  employeeId          Int?               @map(\"employee_id\")\n  /// 客户姓名\n  customerName        String             @map(\"customer_name\")\n  /// 手机号码\n  mobile              String\n  /// 服务地址快照\n  serviceAddress      String             @map(\"service_address\")\n  /// 预约安装日期\n  appointmentDate     DateTime?          @map(\"appointment_date\")\n  /// 预约时段\n  timeSlot            String?            @map(\"time_slot\")\n  /// 派单时间\n  assignedAt          DateTime?          @map(\"assigned_at\")\n  /// 接单时间\n  acceptedAt          DateTime?          @map(\"accepted_at\")\n  /// 上门时间\n  visitedAt           DateTime?          @map(\"visited_at\")\n  /// 安装服务记录\n  serviceRecord       String?            @map(\"service_record\") @db.Text\n  /// 完工图片列表\n  completionImages    Json?              @map(\"completion_images\")\n  /// 客户是否确认完成\n  customerConfirmed   Boolean            @default(false) @map(\"customer_confirmed\")\n  /// 安装服务状态\n  status              InstallationStatus @default(PENDING_APPOINTMENT)\n  /// 完成时间\n  completedAt         DateTime?          @map(\"completed_at\")\n  /// 创建时间\n  createdAt           DateTime           @default(now()) @map(\"created_at\")\n  /// 更新时间\n  updatedAt           DateTime           @updatedAt @map(\"updated_at\")\n\n  /// 关联商品订单\n  order    ProductOrder @relation(fields: [orderId], references: [id])\n  /// 关联员工档案\n  employee Employee?    @relation(fields: [employeeId], references: [id])\n\n  @@index([status, employeeId])\n  @@index([appointmentDate])\n  @@index([status, scheduledEndAt], map: \"installation_status_scheduled_end_idx\")\n  @@map(\"installation_order\")\n}\n\n// ==================== 会员营销 ====================\n\n// 积分流水表：记录用户每次积分收入、使用和调整\nmodel PointRecord {\n  /// 主键 ID\n  id           Int             @id @default(autoincrement())\n  /// 关联用户 ID\n  userId       Int             @map(\"user_id\")\n  /// 积分变动类型\n  type         PointChangeType\n  /// 关联业务类型\n  businessType String?         @map(\"business_type\")\n  /// 关联业务编号\n  relatedNo    String?         @map(\"related_no\")\n  /// 变动数量\n  change       Int\n  /// 变动后积分余额\n  balance      Int\n  /// 描述\n  description  String?         @db.VarChar(300)\n  /// 操作人\n  operator     String?\n  /// 过期时间\n  expiresAt    DateTime?       @map(\"expires_at\")\n  /// 创建时间\n  createdAt    DateTime        @default(now()) @map(\"created_at\")\n\n  /// 后台业务类型；历史无法识别的记录保留 LEGACY_* 类型\n  flowType      String  @default(\"LEGACY\") @map(\"flow_type\") @db.VarChar(32)\n  /// 变动前可用余额\n  balanceBefore Int     @default(0) @map(\"balance_before\")\n  debtBefore    Int     @default(0) @map(\"debt_before\")\n  debtAfter     Int     @default(0) @map(\"debt_after\")\n  /// 获得总额及抵偿数量，仅获得类流水填写\n  earned        Int?\n  offset        Int?\n  /// 关联订单及退款单快照\n  orderId       Int?    @map(\"order_id\")\n  orderNo       String? @map(\"order_no\") @db.VarChar(100)\n  refundNo      String? @map(\"refund_no\") @db.VarChar(100)\n  /// 人工调整审计与幂等信息\n  operatorId    Int?    @map(\"operator_id\")\n  requestId     String? @unique @map(\"request_id\") @db.VarChar(100)\n  amount        Int?\n  source        String?\n\n  user User @relation(fields: [userId], references: [id])\n\n  @@index([userId, createdAt])\n  @@index([createdAt, id])\n  @@index([flowType, createdAt])\n  @@index([expiresAt])\n  @@map(\"point_record\")\n}\n\n// 优惠券模板表：定义券面额、门槛、范围和发行数量\nmodel Coupon {\n  /// 主键 ID\n  id             Int             @id @default(autoincrement())\n  /// 优惠券名称\n  name           String\n  /// 优惠券面额\n  amount         Decimal         @db.Decimal(10, 2)\n  /// 使用门槛\n  threshold      Decimal         @default(0) @db.Decimal(10, 2)\n  /// 适用范围类型\n  scopeType      CouponScopeType @default(ALL) @map(\"scope_type\")\n  /// 适用业务、分类或商品 ID 列表\n  scopeIds       Json?           @map(\"scope_ids\")\n  /// 有效期开始时间\n  validFrom      DateTime        @map(\"valid_from\")\n  /// 有效期结束时间\n  validTo        DateTime        @map(\"valid_to\")\n  /// 发行总量\n  totalQuantity  Int             @map(\"total_quantity\")\n  /// 已发行数量\n  issuedQuantity Int             @default(0) @map(\"issued_quantity\")\n  /// 每人限领数量\n  perUserLimit   Int             @default(1) @map(\"per_user_limit\")\n  /// 优惠券模板状态\n  status         CouponStatus    @default(DRAFT)\n  /// 创建时间\n  createdAt      DateTime        @default(now()) @map(\"created_at\")\n  /// 更新时间\n  updatedAt      DateTime        @updatedAt @map(\"updated_at\")\n\n  /// 关联用户优惠券列表\n  userCoupons UserCoupon[]\n\n  @@index([status, validFrom, validTo])\n  @@map(\"coupon\")\n}\n\n// 用户优惠券表：记录优惠券的领取、使用和过期状态\nmodel UserCoupon {\n  /// 主键 ID\n  id         Int              @id @default(autoincrement())\n  /// 关联用户 ID\n  userId     Int              @map(\"user_id\")\n  /// 关联优惠券模板 ID\n  couponId   Int              @map(\"coupon_id\")\n  /// 关联商品订单 ID\n  orderId    Int?             @unique @map(\"order_id\")\n  projectId  Int?             @unique @map(\"project_id\")\n  /// 用户优惠券状态\n  status     UserCouponStatus @default(AVAILABLE)\n  /// 领取时间\n  receivedAt DateTime         @default(now()) @map(\"received_at\")\n  /// 使用时间\n  usedAt     DateTime?        @map(\"used_at\")\n  /// 过期时间\n  expiresAt  DateTime         @map(\"expires_at\")\n\n  /// 关联用户\n  user    User               @relation(fields: [userId], references: [id])\n  /// 关联优惠券模板\n  coupon  Coupon             @relation(fields: [couponId], references: [id])\n  /// 关联商品订单\n  order   ProductOrder?      @relation(fields: [orderId], references: [id])\n  project RenovationProject? @relation(fields: [projectId], references: [id])\n\n  @@index([userId, status, expiresAt])\n  @@index([couponId])\n  @@map(\"user_coupon\")\n}\n\n// ==================== 服务支持与系统 ====================\n\n// 城市表：跟服务网点关联城市\nmodel ServiceCity {\n  /// 主键 ID\n  id        Int             @id @default(autoincrement())\n  /// 城市名称，如：杭州市\n  name      String          @unique @db.VarChar(50)\n  /// 行政区划代码，由后端根据城市名称生成\n  code      String          @unique @db.VarChar(20)\n  /// 排序值，数值越小越靠前\n  sort      Int             @default(0)\n  /// 是否启用\n  status    Boolean         @default(true)\n  /// 创建时间\n  createdAt DateTime        @default(now()) @map(\"created_at\")\n  /// 更新时间\n  updatedAt DateTime        @updatedAt @map(\"updated_at\")\n  /// 关联服务网点\n  outlets   ServiceOutlet[]\n\n  @@index([status, sort])\n  @@map(\"service_city\")\n}\n\n// 服务网点表：保存线下服务网点、位置和营业信息\nmodel ServiceOutlet {\n  /// 主键 ID\n  id            Int          @id @default(autoincrement())\n  /// 网点名称\n  name          String\n  /// 营业时间\n  businessHours String       @map(\"business_hours\")\n  /// 联系电话\n  phone         String?\n  /// 省份\n  province      String?\n  /// 关联的服务城市ID\n  cityId        Int          @map(\"city_id\")\n  /// 城市名称\n  cityName      String?      @db.VarChar(100)\n  /// 区县\n  district      String?\n  /// 详细地址\n  address       String\n  /// 纬度\n  latitude      Decimal?     @db.Decimal(10, 7)\n  /// 经度\n  longitude     Decimal?     @db.Decimal(10, 7)\n  /// 封面图片\n  cover         String?\n  /// 排序值\n  sort          Int          @default(0)\n  /// 网点是否启用\n  status        Boolean      @default(true)\n  /// 创建时间\n  createdAt     DateTime     @default(now()) @map(\"created_at\")\n  /// 更新时间\n  updatedAt     DateTime     @updatedAt @map(\"updated_at\")\n  /// 城市关系\n  serviceCity   ServiceCity? @relation(fields: [cityId], references: [id], onDelete: Restrict)\n\n  @@index([cityId, status, sort])\n  @@map(\"service_outlet\")\n}\n\n// 意见反馈表：保存客户反馈内容及后台处理结果\nmodel Feedback {\n  /// 主键 ID\n  id          Int            @id @default(autoincrement())\n  /// 反馈编号\n  feedbackNo  String         @unique @map(\"feedback_no\") @db.VarChar(64)\n  /// 关联用户 ID\n  userId      Int?           @map(\"user_id\")\n  /// 处理管理员 ID\n  adminId     Int?           @map(\"admin_id\")\n  /// 反馈类型\n  type        String\n  /// 内容\n  content     String         @db.Text\n  /// 反馈处理状态\n  status      FeedbackStatus @default(PENDING)\n  /// 后台回复内容\n  reply       String?        @db.Text\n  /// 完成时间\n  completedAt DateTime?      @map(\"completed_at\")\n  /// 创建时间\n  createdAt   DateTime       @default(now()) @map(\"created_at\")\n  /// 更新时间\n  updatedAt   DateTime       @updatedAt @map(\"updated_at\")\n\n  /// 关联用户\n  user  User?  @relation(fields: [userId], references: [id])\n  /// 关联处理管理员\n  admin Admin? @relation(fields: [adminId], references: [id])\n\n  @@index([status, createdAt])\n  @@index([userId])\n  @@map(\"feedback\")\n}\n\n// 系统字典表：保存城市、户型、标签和服务时段等选项\nmodel Dictionary {\n  /// 主键 ID\n  id        Int      @id @default(autoincrement())\n  /// 字典类型\n  type      String   @db.VarChar(100)\n  /// 显示名称\n  label     String   @db.VarChar(100)\n  /// 字典值\n  value     String   @db.VarChar(100)\n  /// 显示颜色\n  color     String?  @db.VarChar(100)\n  /// 排序值\n  sort      Int      @default(0)\n  /// 是否启用\n  isEnabled Boolean  @default(true) @map(\"is_enabled\")\n  /// 用户备注\n  remark    String?\n  /// 创建时间\n  createdAt DateTime @default(now()) @map(\"created_at\")\n  /// 更新时间\n  updatedAt DateTime @updatedAt @map(\"updated_at\")\n\n  @@unique([type, value])\n  @@index([type, isEnabled, sort])\n  @@map(\"dictionary\")\n}\n\n// 消息通知记录表：保存发送内容、渠道及发送结果\nmodel Notification {\n  /// 主键 ID\n  id            Int                 @id @default(autoincrement())\n  /// 关联用户 ID\n  userId        Int?                @map(\"user_id\")\n  /// 消息模板编码\n  templateCode  String              @map(\"template_code\")\n  /// 发送渠道\n  channel       NotificationChannel\n  /// 接收目标\n  receiver      String\n  /// 标题\n  title         String?\n  /// 内容\n  content       String              @db.Text\n  /// 关联业务类型\n  businessType  String?             @map(\"business_type\")\n  /// 关联业务编号\n  relatedNo     String?             @map(\"related_no\")\n  /// 消息发送状态\n  status        SendStatus          @default(PENDING)\n  /// 发送失败原因\n  failureReason String?             @map(\"failure_reason\")\n  /// 实际发送时间\n  sentAt        DateTime?           @map(\"sent_at\")\n  /// 创建时间\n  createdAt     DateTime            @default(now()) @map(\"created_at\")\n\n  /// 关联消息接收用户\n  user User? @relation(fields: [userId], references: [id])\n\n  @@index([status, createdAt])\n  @@index([userId, createdAt])\n  @@map(\"notification\")\n}\n\n// 操作日志表：记录后台敏感操作及数据变更前后内容\nmodel OperationLog {\n  /// 主键 ID\n  id           Int      @id @default(autoincrement())\n  /// 处理管理员 ID\n  adminId      Int?     @map(\"admin_id\")\n  /// 操作人类型\n  operatorType String   @map(\"operator_type\")\n  /// 操作人名称\n  operatorName String   @map(\"operator_name\")\n  /// 业务模块\n  module       String   @db.VarChar(64)\n  /// 操作动作\n  action       String\n  /// 跳转目标类型\n  targetType   String?  @map(\"target_type\") @db.VarChar(64)\n  /// 操作目标 ID\n  targetId     String?  @map(\"target_id\") @db.VarChar(64)\n  /// 变更前数据\n  beforeData   Json?    @map(\"before_data\")\n  /// 变更后数据\n  afterData    Json?    @map(\"after_data\")\n  /// 操作 IP 地址\n  ip           String?\n  /// 客户端 User-Agent\n  userAgent    String?  @map(\"user_agent\")\n  /// 创建时间\n  createdAt    DateTime @default(now()) @map(\"created_at\")\n\n  /// 关联处理管理员\n  admin Admin? @relation(fields: [adminId], references: [id])\n\n  @@index([module, targetType, targetId])\n  @@index([adminId, createdAt])\n  @@index([createdAt])\n  @@map(\"operation_log\")\n}\n\n// 积分规则表：当前全局配置；历史订单需另存下单时的规则快照。\n// 全局规则约定使用 id = 1；比例不设默认值，由管理员明确配置后创建。\nmodel PointRule {\n  /// 全局规则固定 ID，不使用自增\n  id            Int      @id @default(1)\n  /// 购物赠送开关，关闭时保留比例\n  rewardEnabled Boolean  @default(false) @map(\"reward_enabled\")\n  /// 每实付多少元参与奖励，必须大于 0\n  rewardYuan    Decimal  @map(\"reward_yuan\") @db.Decimal(10, 2)\n  /// 对应赠送积分，必须为正整数\n  rewardPoints  Int      @map(\"reward_points\")\n  /// 积分抵扣开关，关闭时保留比例\n  deductEnabled Boolean  @default(false) @map(\"deduct_enabled\")\n  /// 每次兑换所需积分，必须为正整数\n  deductPoints  Int      @map(\"deduct_points\")\n  /// 对应抵扣金额，必须大于 0\n  deductYuan    Decimal  @map(\"deduct_yuan\") @db.Decimal(10, 2)\n  /// 单笔抵扣上限百分比，范围 0～100\n  limit         Int\n  /// 规则版本，保存规则时由业务层递增\n  version       Int      @default(1)\n  /// 最后修改规则的管理员 ID，从登录信息获取\n  updatedById   Int      @map(\"updated_by_id\")\n  /// 创建时间\n  createdAt     DateTime @default(now()) @map(\"created_at\")\n  /// 更新时间\n  updatedAt     DateTime @updatedAt @map(\"updated_at\")\n\n  /// 关联最后修改规则的管理员，保留操作人追溯关系\n  updatedBy Admin @relation(fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Cascade)\n\n  @@index([updatedById])\n  @@map