{
  "extends": "@vue/tsconfig/tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "sourceMap": true,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "lib": [
      "esnext",
      "dom"
    ],
    "types": [
      "@dcloudio/types",
      "miniprogram-api-typings",
      "@uni-helper/uni-app-types",
      "@uni-helper/uni-ui-types"
    ]
  },
  "vueCompilerOptions": {
    // uni-app 的 view、text、image 使用组件类型，避免被识别成同名 SVG 元素。
    // nativeTags 兼容 vue-tsc 1.x，插件为新版 Vue - Official 配置标签识别。
    "nativeTags": ["block", "component", "template", "slot"],
    "plugins": ["./tools/uni-template-plugin.cjs"]
  },
  "include": [
    "components.d.ts",
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.tsx",
    "src/**/*.vue"
  ]
}
